# Copy to .env (never commit .env). Leave a key blank to skip that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides — check each provider's model list for current IDs
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash

# Streamlit -> API mode (leave blank for local mode)
API_URL=
# Optional shared secret: if set on Vercel, the API requires header x-api-key
API_KEY=
